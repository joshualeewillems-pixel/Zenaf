# Zenaf — copy to .env.local or export in your shell (never commit secrets).
# See README.md and CONTRIBUTING.md.

# --- Settings / LLM keys (optional) ---
# Fernet key for encrypted provider credentials in Settings UI.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ZENAF_SETTINGS_ENCRYPTION_KEY=

# --- Dev bootstrap passwords (optional; only on first DB init) ---
# ZENAF_BOOTSTRAP_PASSWORD=local-dev-owner
# ZENAF_PHIL_BOOTSTRAP_PASSWORD=phil-local-dev

# --- Operator notifications (optional; dry-run safe for local dev) ---
# ZENAF_NOTIFICATIONS_ENABLED=1
# ZENAF_SMS_PROVIDER=dryrun
# ZENAF_NOTIFICATIONS_COOLDOWN_HOURS=24

# --- Operator supervisor (optional) ---
# ZENAF_SUPERVISOR_ENABLED=1
# ZENAF_SUPERVISOR_AUTO_READY=0
# ZENAF_SUPERVISOR_DRYRUN=0
# ZENAF_SUPERVISOR_MAX_VISIBLE=5
# ZENAF_SUPERVISOR_MAX_DECISION=3
# ZENAF_SUPERVISOR_INCLUDE_INFO=0
# ZENAF_SUPERVISOR_ONE_NOW=1
# ZENAF_STUDIO_BASE_URL=http://127.0.0.1:5173/studio

# --- Learning export (optional) ---
# ZENAF_LEARNING_EXPORT_ENABLED=0
# ZENAF_LEARNING_PERSIST_PATH=
# ZENAF_LEARNING_PERSIST_MAX_MB=

# --- Intake IMAP (optional; do not commit real passwords) ---
# INTAKE_IMAP_HOST=
# INTAKE_IMAP_USER=
# INTAKE_IMAP_PASSWORD=

# --- Ollama / local LLM ---
# Default paths use local Ollama; configure in Settings when encryption key is set.
