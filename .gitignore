# Python bytecode caches
__pycache__/

# Local runtime data — never publish
*.db
*.db-journal
activity.log
debug-*.log
intake_mirror.db
data/vision_execution/

# Local workspace identity mirror (bounded scan; not system of record)
.zenaf/workspace-identity/

# Local intake IMAP config (may contain password); do not commit
intake_imap_config.json
# Gmail OAuth tokens and client config (do not commit)
intake_gmail_oauth.json
intake_gmail_oauth_pkce.json
intake_google_oauth_config.json

# Nightly harness output (local)
logs/nightly_self_exercise/
e2e/nightly/node_modules/
e2e/nightly/playwright-report/
e2e/nightly/test-results/

# Debug: last council enriched packet (local_ai/council_preflight.py)
last_packet.txt

# Wave exit gate local report (CI uploads as artifact)
wave_exit_report.json

# Generated / machine-local reports (regenerate via scripts)
reports/arc_detection/
reports/system_conformance/
reports/philosophy_council/sessions/
reports/philosophy_council/queued/
reports/philosophy_enforcement/

# ARC lab: machine-specific user/project ids (regenerate: python scripts/seed_arc_lab_fixtures.py)
reports/arc_lab/manifest.json

# Local notification credentials (Twilio SMS etc.) — never commit
.env.local
.env.notifications
# Notification state (per-machine, contains operator decision history)
reports/notifications/
reports/operator_supervisor/
# Local debug helper (redacts secrets but still local-only)
scripts/_debug_notif_env.py
